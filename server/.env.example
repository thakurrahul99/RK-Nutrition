PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Super Admin Developer Provisioning
SUPER_ADMIN_NAME=Lead Systems Developer
SUPER_ADMIN_EMAIL=developer@rknutrition.com
SUPER_ADMIN_PASSWORD=your_secure_dev_password

# Client Admin Store Owner Provisioning
CLIENT_ADMIN_NAME=RK Store Manager
CLIENT_ADMIN_EMAIL=storeowner@rknutrition.com
CLIENT_ADMIN_PASSWORD=your_secure_client_password

# Database Configuration (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/rk_nutrition

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="RK Nutrition" <orders@rknutrition.com>
